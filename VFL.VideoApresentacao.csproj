<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VFL.EditorApresentacao</AssemblyName>
    <RootNamespace>VFL.VideoApresentacao</RootNamespace>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>VFL Editor de Apresentação</AssemblyTitle>
    <Product>VFL Editor de Apresentação</Product>
    <Company>VFL</Company>
    <Copyright>Copyright © 2026 VFL</Copyright>
    <Authors>VFL</Authors>
    <Description>Editor local para montar vídeos de apresentação padronizados com perfis configuráveis.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="VFL.GeradorWebMToken\**\*.cs" />
    <Compile Remove="VFL-Editor-Automatico\**\*.cs" />
    <Compile Remove="VFL-Gerador-WebM-Token\**\*.cs" />
    <Content Include="Tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\vfl-suite-logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\ffprobe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\FFMPEG-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LICENSE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
